# ==============================================================================
# PostPilot Universal Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#      cp .env.example .env
# 2. Update settings according to your target runtime:
#      - Environment A: Web Server (Linux VPS / Cloud) -> APP_ENV=production
#      - Environment B: Android Phone (Termux)         -> APP_ENV=termux
#      - Local PC Development                          -> APP_ENV=development
# 3. IMPORTANT: NEVER commit '.env' or access tokens to version control!
# ==============================================================================

# --- Runtime Environment Profile ---
# Supported values: development | termux | production
APP_ENV=development

# --- Flask Server Settings ---
# In production, generate a secure random key (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`)
SECRET_KEY=change-this-to-a-secure-random-secret-key
FLASK_DEBUG=0
HOST=127.0.0.1
PORT=5000

# --- Database Configuration ---
# Termux / Local: Built-in SQLite
DATABASE_URL=sqlite:///data/posts.db
# Web Server (PostgreSQL example):
# DATABASE_URL=postgresql://postpilot_user:strong_password@localhost:5432/postpilot_db

# --- Storage & Media Configuration ---
POSTPILOT_DATA_DIR=data
POSTPILOT_UPLOAD_FOLDER=data/images
MAX_CONTENT_LENGTH=16777216  # 16 MB max upload size

# --- Security & Authentication Settings ---
# LOCAL_MODE: When enabled, requests originating strictly from localhost (127.0.0.1)
# are automatically granted local admin access for a seamless single-user experience on phone/Termux.
# External connections across network interfaces ALWAYS require username & password.
LOCAL_MODE=1
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
SESSION_COOKIE_SECURE=0  # Set to 1 in production behind HTTPS

# --- Meta / Facebook Graph API Credentials ---
# Primary User Access Token (with pages_manage_posts, pages_read_engagement permissions)
FB_ACCESS_TOKEN=

# Facebook Page IDs
FB_PAGE_ID_SUITE=967550829768297
FB_PAGE_ID_PHOENIX=954901604381882
FB_PAGE_ID_GAATHA_AI=1028368893692590

# Instagram Business Account IDs (connected to Facebook Pages)
INSTA_ID_SUITE=17841449080283492
INSTA_ID_PHOENIX=17841472248438802

# --- Automation Intervals (in seconds) ---
TOUR_INTERVAL=1800   # 30 minutes
VISA_INTERVAL=1800   # 30 minutes
GAATHA_INTERVAL=1800 # 30 minutes
INSTA_CHECK_INTERVAL=180 # 3 minutes
