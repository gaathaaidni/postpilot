# ==============================================================================
# PostPilot Universal Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#      cp .env.example .env
# 2. Update settings according to your target runtime:
#      - Environment A: Web Server (Linux VPS / Cloud) -> APP_ENV=production
#      - Environment B: Android Phone (Termux)         -> APP_ENV=termux
#      - Local PC Development                          -> APP_ENV=development
# 3. IMPORTANT: NEVER commit '.env' or access tokens to version control!
# ==============================================================================

# --- Runtime Environment Profile ---
# Supported values: development | termux | production
# Automatically detected in Termux if unset, but explicitly configured here.
APP_ENV=development

# --- Flask Server Settings ---
# In production, generate a secure random key (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`)
# In development/termux, defaults to 'postpilot-dev-secret-key-change-in-production' if left blank.
SECRET_KEY=postpilot-dev-secret-key-change-in-production
FLASK_DEBUG=0

# Network binding
# Binds strictly to loopback (127.0.0.1) in development and Termux for security.
# Production web servers bind to 0.0.0.0 or 127.0.0.1 behind Nginx.
HOST=127.0.0.1
PORT=5000

# --- Database Configuration ---
# Termux / Local: Built-in SQLite with WAL mode
DATABASE_URL=sqlite:///data/posts.db
# Web Server (PostgreSQL example):
# DATABASE_URL=postgresql://postpilot_user:strong_password@localhost:5432/postpilot_db

# --- Storage & Media Configuration ---
POSTPILOT_DATA_DIR=data
POSTPILOT_UPLOAD_FOLDER=data/images
MAX_CONTENT_LENGTH=16777216  # 16 MB max upload size

# --- Security & Authentication Settings ---
# LOCAL_MODE: When enabled (1), requests originating strictly from localhost (127.0.0.1 / ::1)
# are automatically granted local admin access for a seamless single-user experience on phone/Termux.
# External connections across network interfaces ALWAYS require username & password.
# LOCAL_MODE is strictly disabled in production regardless of this setting.
LOCAL_MODE=1
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
SESSION_COOKIE_SECURE=0  # Set to 1 in production behind HTTPS

# --- AI Marketing Studio Configuration ---
# Configured AI provider. Supported values:
#   - mock: Built-in deterministic mock provider. 100% offline, 0 API keys, 0 external HTTP requests.
#   - groq: Fast cloud inference using Groq OpenAI-compatible endpoints.
#   - openai: Official OpenAI API endpoints.
#   - openai_compatible: Generic OpenAI-compatible endpoints (Local Ollama, Together, DeepSeek, vLLM).
# Default: 'mock' (safe for offline Termux and air-gapped environments).
AI_PROVIDER=mock

# Timeout for AI generation requests (in seconds)
AI_TIMEOUT_SECONDS=30

# AI Cost Controls & Generation Guardrails
AI_MAX_PLATFORMS_PER_REQUEST=5
AI_MAX_PROMPT_CHARS=8000
AI_MAX_OUTPUT_TOKENS=1500
AI_ORG_HOURLY_GENERATION_LIMIT=60
AI_DEDUPLICATION_WINDOW_SECONDS=15

# --- Optional Third-Party AI Credentials (leave blank for offline mock mode) ---
# Groq:
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI:
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Generic OpenAI-Compatible / Local Provider:
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# --- Meta / Facebook Graph API Credentials ---
# Primary User Access Token (with pages_manage_posts, pages_read_engagement permissions)
# Leave blank for offline / local-only operation without live publishing.
FB_ACCESS_TOKEN=

# Facebook Page IDs
FB_PAGE_ID_SUITE=967550829768297
FB_PAGE_ID_PHOENIX=954901604381882
FB_PAGE_ID_GAATHA_AI=1028368893692590

# Instagram Business Account IDs (connected to Facebook Pages)
INSTA_ID_SUITE=17841449080283492
INSTA_ID_PHOENIX=17841472248438802

# --- LinkedIn Dual-Application API Credentials ---
# Aidni Global LLP
LINKEDIN_CLIENT_ID_AIDNI_GLOBAL_LLP=
LINKEDIN_CLIENT_SECRET_AIDNI_GLOBAL_LLP=
LINKEDIN_ACCESS_TOKEN_AIDNI_GLOBAL_LLP=
LINKEDIN_ORG_ID_AIDNI_GLOBAL=145240694

# Gaatha Ventures Sh.p.k.
LINKEDIN_CLIENT_ID_GAATHA_VENTURES=
LINKEDIN_CLIENT_SECRET_GAATHA_VENTURES=
LINKEDIN_ACCESS_TOKEN_GAATHA_VENTURES=
LINKEDIN_ORG_ID_GAATHA_VENTURES=145250613

# Shared OAuth Redirect URI
LINKEDIN_REDIRECT_URI=http://127.0.0.1:5000/api/auth/linkedin/callback

# Legacy/Single-App Fallbacks (optional)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=

# --- Automation Intervals (in seconds) ---
TOUR_INTERVAL=1800   # 30 minutes
VISA_INTERVAL=1800   # 30 minutes
GAATHA_INTERVAL=1800 # 30 minutes
INSTA_CHECK_INTERVAL=180 # 3 minutes
